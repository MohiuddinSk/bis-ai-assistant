# Offline corpus-ingestion tooling only; never used by the serving backend.
FROM python:3.11.14-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONUTF8=1 LANG=C.UTF-8 LC_ALL=C.UTF-8
WORKDIR /workspace
RUN apt-get update && apt-get install --no-install-recommends -y tesseract-ocr tesseract-ocr-eng poppler-utils libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements-ocr.txt /tmp/requirements-ocr.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements-ocr.txt
RUN groupadd --gid 10001 bis && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin bis && mkdir -p /workspace/tmp/ocr /workspace/data/processed/generated_v4 && chown -R bis:bis /workspace
USER 10001:10001
CMD ["python", "--version"]
